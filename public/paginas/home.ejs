		<script>
			(function () {
				const selEstado = document.getElementById('heroEstado');
				const selCidade = document.getElementById('heroCidade');
				const form = document.getElementById('heroBuscaForm');
				if (!selEstado || !selCidade || !form) return;

				function slugify(t) {
					return (t || '').toString().toLowerCase().normalize('NFD')
						.replace(/[̀-ͯ]/g, '')
						.replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
				}

				let cidadesPorUf = null;

				async function carregarCidades() {
					if (cidadesPorUf) return cidadesPorUf;
					cidadesPorUf = {};
					try {
						const res = await fetch('/api/cidades');
						const cidades = await res.json();
						cidades.forEach(c => {
							const uf = (c.estado || '').toLowerCase();
							if (!uf || !c.nome) return;
							(cidadesPorUf[uf] = cidadesPorUf[uf] || []).push(c.nome);
						});
					} catch (e) {
						console.error('Erro ao carregar cidades do hero:', e);
					}
					return cidadesPorUf;
				}

				selEstado.addEventListener('change', async function () {
					const uf = selEstado.value;
					selCidade.innerHTML = '<option value="">Selecione a cidade</option>';
					if (!uf) { selCidade.disabled = true; return; }

					const mapa = await carregarCidades();
					const lista = (mapa[uf] || []).slice().sort((a, b) => a.localeCompare(b, 'pt-BR'));

					lista.forEach(nome => {
						const opt = document.createElement('option');
						opt.value = nome;
						opt.textContent = nome;
						selCidade.appendChild(opt);
					});
					selCidade.disabled = lista.length === 0;
				});

				form.addEventListener('submit', function (e) {
					e.preventDefault();
					const uf = selEstado.value;
					const cidade = selCidade.value;
					if (!uf) { selEstado.focus(); return; }
					if (cidade) {
						window.location.href = `/carros/${slugify(cidade)}/${uf}`;
					} else {
						window.location.href = `/carros/${uf}`;
					}
				});
			})();
		</script>
